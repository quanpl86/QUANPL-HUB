{
  "name": "king-dragon-hub-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Local Worker for KING DRAGON HUB Content OS — polls Supabase tasks and processes via NotebookLM MCP",
  "type": "module",
  "scripts": {
    "start": "npx tsx worker.ts",
    "dev": "npx tsx --watch worker.ts",
    "auth": "npx tsx scripts/recover-auth.ts",
    "dashboard": "npx tsx api.ts",
    "all": "npx tsx api.ts & npx tsx --watch worker.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pan-sec/notebooklm-mcp": "^2026.3.2",
    "@supabase/supabase-js": "^2.104.1",
    "bullmq": "^5.76.5",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4",
    "ioredis": "^5.10.1",
    "marked": "^18.0.2",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
